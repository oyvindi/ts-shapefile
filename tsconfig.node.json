{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "declaration": false,
    "noImplicitAny": true,
    "removeComments": true,
    "inlineSourceMap": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./node.ts", "./index.ts", "./src/**/*.ts"]
}
