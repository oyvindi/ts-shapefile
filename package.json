{
  "name": "ts-shapefile",
  "version": "1.1.0",
  "description": "Library for reading ESRI Shapefiles",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/index.umd.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs",
      "default": "./dist/node.cjs"
    }
  },
  "author": "Oyvind Idland",
  "license": "MIT",
  "homepage": "https://github.com/oyvindi/ts-shapefile",
  "keywords": [
    "shapefile",
    "ESRI",
    "ArcGIS",
    "TypeScript"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@placemarkio/check-geojson": "0.1.14",
    "@rolldown/plugin-node-polyfills": "1.0.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.4.1",
    "buffer": "6.0.3",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "iconv-lite": "0.7.3"
  }
}
